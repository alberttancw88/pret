# Copy to .env.local (never commit .env.local). Values come from the pret-dev Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Direct Postgres via Supavisor transaction pooler (ADR-0002).
DATABASE_URL=
# Server-only. Field-encryption key material (ADR-0003); generated per environment.
PRET_FIELD_KEY_V1=
# Server-only. Supabase root CA for verified TLS to the pooler (no unverified fallback).
# Path to the downloaded certificate, kept OUTSIDE the repo or under private/ (git-ignored).
DATABASE_CA_CERT_FILE=
# Alternative to the file: the PEM text itself.
DATABASE_CA_CERT=
# Server-only. Supabase secret API key (sb_secret_...) — used for invitation acceptance only.
SUPABASE_SECRET_KEY=
# Server-only. Transactional email via Resend (D21) — invitation emails send directly (token only in the email, ADR-0014).
RESEND_API_KEY=
# Sender, e.g. PRET <no-reply@your-verified-domain>. Required together with RESEND_API_KEY.
PRET_EMAIL_FROM=
# Server-only. Shared secret for the daily Vercel Cron route /api/cron/daily (scheduled invitations).
# Vercel sends it as 'Authorization: Bearer <value>'. Generate a long random value per environment; set it in Vercel project env.
CRON_SECRET=
